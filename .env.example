# OpenAI 兼容网关配置（DeepSeek / 第三方中转均可）
LLM_BASE_URL=https://tokenrhythm.studio/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-v4-flash

# RAG 检索参数
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 本地 Embedding 模型（FastEmbed 自动下载，离线可用）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# Hugging Face 镜像（国内/受限网络环境；如可直连可删掉该行）
HF_ENDPOINT=https://hf-mirror.com
# 禁用 HF Xet 存储通道（镜像/受限网络下避免 CAS 401；若直连正常可改为 0）
HF_HUB_DISABLE_XET=1

# 数据目录（相对项目根目录）
DATA_DIR=./data

# 数据库：默认 SQLite；也可切换 MySQL：mysql+pymysql://user:pass@host:3306/rag_qa
CHAT_DB_URL=sqlite:///./data/chat.db